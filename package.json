{
  "name": "watch-notes",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhii-samborskyi/WatchNotes.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,export \"npm:dev:web\" \"npm:dev:export\"",
    "dev:web": "vinext dev --port 3002",
    "dev:export": "tsx watch server/index.ts",
    "build": "vinext build",
    "start": "concurrently -k -n web,export \"vite preview --host 0.0.0.0 --port 3002 --strictPort\" \"tsx server/index.ts\"",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "benchmark:export": "tsx scripts/benchmark-export.ts"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.54.0",
    "midi-file": "^1.2.4",
    "next": "^16.4.0",
    "puppeteer-core": "^25.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spessasynth_core": "^4.3.22",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "concurrently": "^10.0.6",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "type": "module"
}
